# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal
*.md
auto.ps1
!README.md

# PHP API sensitive files
api-php/vendor/
api-php/.env
api-php/config.local.php
api-php/*.log
api-php/error_log

# Python model files (if they contain sensitive data)
phish_detect-1.0/src/*.pkl
phish_detect-1.0/src/*.model
phish_detect-2.0/src/*.pkl
phish_detect-2.0/src/*.model

# Any other environment or config files with real values
**/.env.production
**/.env.local
**/config.production.php
**/secrets.json
**/credentials.json